{
  "name": "autocut-electron-app",
  "description": "AutoCut V4 Electron App",
  "version": "4.60.33",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.18.0"
  },
  "author": {
    "email": "contact@autocut.fr",
    "name": "AutoCut",
    "url": "https://www.autocut.com"
  },
  "main": "packages/main/dist/index.js",
  "scripts": {
    "===== ELECTRON FORGE =====": "==================",
    "forge:start": "electron-forge start --inspect-electron",
    "forge:package": "electron-forge package",
    "forge:make:darwin": "electron-forge make --platform=darwin --arch=universal",
    "forge:make:win32": "electron-forge make",
    "forge:make": "run-script-os",
    "forge:publish:darwin": "electron-forge publish --platform=darwin --arch=universal",
    "forge:publish:win32": "electron-forge publish",
    "forge:publish": "run-script-os",
    "===== VITE =====": "==================",
    "build:main": "cd ./packages/main && vite build",
    "build:preload": "cd ./packages/preload && vite build",
    "===== SCRIPTS =====": "==================",
    "watch": "node scripts/watch.js",
    "build:sysr": "node scripts/buildSystemReport.mjs",
    "download-sysr": "yarn build:sysr",
    "prepare-build": "yarn build:sysr && yarn compile && node scripts/prepareBuild.js",
    "clean-build": "node ./scripts/cleanBuild.js",
    "preload:generate-type": "tsx ./scripts/extractPreloadTypes.ts",
    "===== HIGH LEVEL =====": "==================",
    "compile": "yarn build:main && yarn build:preload",
    "dev": "yarn build:sysr && cross-env MODE=development NODE_ENV=development yarn compile && yarn forge:start",
    "dev:sysr": "touch ~/Library/Application\\ Support/AutoCutDev/starting && yarn dev",
    "build:darwin": "yarn prepare-build && cd .temp_build && yarn forge:package --platform=darwin --arch=universal",
    "build:win32": "yarn prepare-build && cd .temp_build && yarn forge:package",
    "build": "run-script-os",
    "build:clean": "yarn build && yarn clean-build",
    "===== OTHERS =====": "==================",
    "eslint": "yarn --cwd ../../.. eslint",
    "lint": "yarn --cwd ../../.. lint:electron",
    "typecheck:main": "tsc --noEmit -p packages/main/tsconfig.json",
    "typecheck:preload": "tsc --noEmit -p packages/preload/tsconfig.json",
    "typecheck": "npm run typecheck:main && npm run typecheck:preload",
    "test": "yarn test:qa && yarn test:sysr",
    "test:sysr": "node --test scripts/buildSystemReport.test.mjs",
    "test:qa": "node --experimental-strip-types --test packages/main/src/qa/qaContracts.test.ts",
    "clean:sysr:darwin": "find buildResources/assets/sysr ! -path buildResources/assets/sysr/README.md -a ! -path buildResources/assets/sysr -delete",
    "clean:sysr:win32": "del /s /q buildResources\\assets\\sysr",
    "clean:sysr": "run-script-os",
    "postinstall": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/update-electron-vendors.js",
    "format": "prettier --write \"**/*.{js,mjs,cjs,ts,mts,cts,vue,json}\"",
    "logs": "osascript -e 'tell app \"Terminal\" to do script \"cd $TMPDIR/com.autocut/com.autocut.aea && tail -n 50 -f autocut.host.log\"'"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.8.0",
    "@types/node": "24.13.3",
    "cross-env": "7.0.3",
    "dts-bundle-generator": "9.5.1",
    "electron": "43.2.0",
    "glob": "11.0.0",
    "ora": "8.0.1",
    "prettier": "3.3.2",
    "run-script-os": "1.1.6",
    "tsx": "4.19.4",
    "typescript": "5.8.3",
    "vite": "6.2.6"
  },
  "dependencies": {
    "@kezios/node-ipc": "1.2.2-9c1fbf1",
    "@sentry/electron": "6.5.0",
    "axios": "1.6.7",
    "dotenv": "17.2.3",
    "fflate": "0.8.2",
    "got": "14.4.2",
    "posthog-node": "^5.38.2",
    "sudo-prompt": "9.2.1",
    "velopack": "1.2.0"
  },
  "optionalDependencies": {
    "appdmg": "0.6.6"
  },
  "resolutions": {
    "@electron/universal": "3.0.6"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
